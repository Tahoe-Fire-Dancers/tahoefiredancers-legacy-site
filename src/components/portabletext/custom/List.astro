---
import type { Props as $, ListItem } from "astro-portabletext/types";

export type Props = $<ListItem>;

const { node, index, isInline, ...attrs } = Astro.props;
//console.log("List Item", node);
---

<li 
  {...attrs} 
  class="relative pl-8 mb-3 text-lg text-white dark:text-neonGreen leading-relaxed transition hover:text-neonYellow"
>
  <span 
    class="absolute left-0 top-1/2 transform -translate-y-1/2 text-gold text-2xl font-bold">
    ✦
  </span>
  <slot />
</li>

<style>
  .text-gold {
    color: goldenrod;
  }
</style>
