---
import { YouTube } from '@astro-community/astro-embed-youtube';
import type { Props as $, TypedObject } from "astro-portabletext/types";

export type Props = $<TypedObject>;

const props = Astro.props;
const { node, ...attrs } = props;
console.log("Props looking for youtube", props.node);
const youtubeURL = props.node?.url;
const youtubeTitle = props.node?.Title;
console.log("Youtube URL", youtubeTitle, youtubeURL);
---

<!-- <Tweet id="https://twitter.com/astrodotbuild/status/1512144306898976768" />

<Vimeo id="https://vimeo.com/32001208" /> -->
{youtubeURL ? (
  <div class="flex justify-center items-center w-full">
    <div class="relative w-full max-w-4xl aspect-video rounded-lg overflow-hidden shadow-lg">
        <YouTube id={youtubeURL} title={youtubeTitle} class="w-full h-full m-auto border border-black rounded-lg shadow-lg shadow-[0_35px_60px_-15px_rgba(0,0,0,0.3)]" />
    </div>
  </div>
) : (
  <p class="text-red-500 text-center">Video Failed to Load.</p>
)}



