---
import type { Props as $, TypedObject } from "astro-portabletext/types";
import { urlFor } from "../../../../sanity/image";

export type Props = $<TypedObject>;

const props = Astro.props;
const { node, ...attrs } = props;

// Get the image reference from the Sanity Portable Text node
const blogImageRef = node.asset?._ref;

// Generate the image URL using the `urlFor` function
const blogImageUrl = blogImageRef ? urlFor(blogImageRef).url() : null;
---

{blogImageUrl ? (
  <div class="relative group flex justify-center items-start w-full lg:items-start lg:justify-start">
    <div class="relative w-full max-w-(--breakpoint-lg)">
      <img
        src={blogImageUrl}
        alt={node.alt || "Blog Image"}
        class="w-full max-h-[600px] object-contain overflow-hidden rounded-lg shadow-md transition-transform transform hover:scale-105 lg:object-top"
        {...attrs}
      />
      {/* Cyberpunk Glow Overlay */}
      <div class="absolute inset-0 w-full h-full rounded-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none animate-pulse"></div>
    </div>
  </div>
) : (
  <p class="text-red-500 text-center">Image failed to load.</p>
)}
