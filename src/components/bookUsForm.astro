<!-- Load VanillaJS Datepicker -->
<script src="https://cdn.jsdelivr.net/npm/vanillajs-datepicker@1.2.0/js/datepicker-full.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {
    console.log("Initializing datepicker...");

    const startDateInput = document.getElementById("start-date");
    const endDateInput = document.getElementById("end-date");

    if (startDateInput && endDateInput) {
        new Datepicker(startDateInput, {
            format: 'yyyy-mm-dd',
            autohide: true,
            todayHighlight: true
        });
        new Datepicker(endDateInput, {
            format: 'yyyy-mm-dd',
            autohide: true,
            todayHighlight: true
        });
        console.log("Datepicker successfully initialized!");
    } else {
        console.error("Datepicker input fields not found!");
    }
});
</script>


  <script>
    //import  Datepicker  from 'vanillajs-datepicker';
    //console.log(Datepicker);
   
    const handleSubmit = (event) => {
        event.preventDefault();
        document.getElementById('bookFormSubmit').disabled = true;  
        document.getElementById('bookFormSubmit').innerHTML = "Sent!";
        document.getElementById('bookFormSubmit').classList.remove('bg-torange');
        document.getElementById('bookFormSubmit').classList.add('bg-tteal');
        document.getElementById('bookFormSubmit').classList.add('cursor-not-allowed');
        // document.getElementById('phone-input').value = formatPhoneNumber(document.getElementById('phone-input').value);
      
        const myForm = event.target;
        const formData = new FormData(myForm);
        //const URLformData = new URLSearchParams(formData).toString();
        //console.log(URLformData);
        fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(formData).toString(),
        })
          .then(() => alert("Thank You for your inquiring a booking! We Will get back to you shortly!"))
          .catch((error) => alert(error));
      };
      
      document
        .querySelector("form")
        .addEventListener("submit", handleSubmit);
      

  </script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
        console.log("Overriding Datepicker styles...");
    
        // Create a <style> tag and inject stronger CSS rules
        const style = document.createElement("style");
        style.innerHTML = `
            .datepicker-dropdown .datepicker-cell { color: black !important; }
            .datepicker-dropdown .datepicker-cell:hover, .datepicker-dropdown .datepicker-cell.focused { background-color: blue !important; color: white !important; }
            .datepicker-dropdown .datepicker-cell.selected { background-color: blue !important; color: white !important; font-weight: bold !important; }
            .datepicker-dropdown .datepicker-cell.today { border: 2px solid black !important; color: black !important; }
            .datepicker-dropdown .datepicker-cell.disabled { color: gray !important; }
        `;
        document.head.appendChild(style);
    
        console.log("Datepicker styles successfully overridden!");
    });
    </script>
