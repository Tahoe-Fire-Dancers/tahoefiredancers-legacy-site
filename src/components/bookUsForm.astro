<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vanillajs-datepicker@1.3.4/dist/css/datepicker.min.css">
<style>
    /* Override default text color for all datepicker cells */
    .datepicker-dropdown .datepicker-cell {
        color: black !important;
    }

    /* Ensure that selected, hovered, and focused cells are styled properly */
    .datepicker-dropdown .datepicker-cell:hover,
    .datepicker-dropdown .datepicker-cell.focused {
        background-color: blue !important;
        color: white !important; /* Ensure text is visible */
    }

    /* Override styles for the selected date */
    .datepicker-dropdown .datepicker-cell.selected {
        background-color: blue !important;
        color: white !important;
        font-weight: bold !important;
    }

    /* Ensure today’s date remains visible */
    .datepicker-dropdown .datepicker-cell.today {
        border: 2px solid black !important;
        color: black !important;
    }

    /* Override Tailwind/DaisyUI defaults */
    .datepicker-dropdown {
        background-color: white !important;
        border: 1px solid #ccc !important;
    }

    /* Fix issues for disabled dates */
    .datepicker-dropdown .datepicker-cell.disabled {
        color: gray !important;
    }
</style>
<script>
    // Ensure function is globally available
    window.formatPhoneNumber = function(input) {
        let value = input.value.replace(/\D/g, ""); // Remove non-numeric characters
  
        if (value.length > 10) {
            value = value.substring(0, 10); // Limit to 10 digits
        }
  
        let formattedValue = "";
        if (value.length > 6) {
            formattedValue = `(${value.substring(0, 3)}) ${value.substring(3, 6)}-${value.substring(6)}`;
        } else if (value.length > 3) {
            formattedValue = `(${value.substring(0, 3)}) ${value.substring(3)}`;
        } else if (value.length > 0) {
            formattedValue = `(${value}`;
        }
  
        input.value = formattedValue; // Update the input field
    };
  </script>
  
    
